<mxfile host="Electron">
  <diagram id="runtime" name="Runtime Flow">
    <mxGraphModel dx="1417" dy="823" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="2100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t0" parent="1" style="text;html=1;fontSize=20;fontStyle=1;align=center;" value="Cross-Cluster Agents Demo — Runtime Flow" vertex="1">
          <mxGeometry height="35" width="800" x="350" y="10" as="geometry" />
        </mxCell>
        <mxCell id="wc" parent="1" style="swimlane;startSize=35;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;" value="Workload Cluster" vertex="1">
          <mxGeometry height="2000" width="530" x="10" y="55" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="wc" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontStyle=2;" value="Agent: chatbot-1 (agents-chatbots ns)&#xa;Pattern: conversational | Group: chatbots" vertex="1">
          <mxGeometry height="45" width="490" x="20" y="50" as="geometry" />
        </mxCell>
        <mxCell id="s1box" parent="wc" style="swimlane;startSize=25;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" value="① Start Signal — operator starts the agent via its control API" vertex="1">
          <mxGeometry height="118" width="490" x="20" y="110" as="geometry" />
        </mxCell>
        <mxCell id="s1cm" parent="s1box" style="rounded=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" value="POST :8080/start&#xa;from the agent console or start-agents.sh&#xa;&#xa;Pod runs permanently and sits IDLE until this&#xa;arrives — no restart, no token re-mint.&#xa;Repeats its pattern until /stop." vertex="1">
          <mxGeometry height="82" width="230" x="15" y="28" as="geometry" />
        </mxCell>
        <mxCell id="s1prof" parent="s1box" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="ConfigMap: agent-profile&#xa;pattern: conversational&#xa;thinkTimeMin: 3s, Max: 8s&#xa;keyTtlSeconds: 300  (per-group: chatbots 300s, reviewers 600s, analysts 120s)" vertex="1">
          <mxGeometry height="82" width="210" x="260" y="28" as="geometry" />
        </mxCell>
        <mxCell id="s2box" parent="wc" style="swimlane;startSize=25;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" value="② Token Mint — Agent calls Keycloak" vertex="1">
          <mxGeometry height="180" width="490" x="20" y="260" as="geometry" />
        </mxCell>
        <mxCell id="s2req" parent="s2box" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;" value="POST https://sso.apps.&lt;domain&gt;/realms/agent-realm&#xa;      /protocol/openid-connect/token&#xa;&#xa;Body:&#xa;  grant_type=client_credentials&#xa;  client_id=chatbot-1&#xa;  client_secret=&lt;from K8s Secret&gt;" vertex="1">
          <mxGeometry height="90" width="460" x="15" y="30" as="geometry" />
        </mxCell>
        <mxCell id="s2resp" parent="s2box" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="← Response: JWT (cached until exp-30s)" vertex="1">
          <mxGeometry height="35" width="460" x="15" y="135" as="geometry" />
        </mxCell>
        <mxCell id="s3box" parent="wc" style="swimlane;startSize=25;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" value="③ API Key Mint — Agent calls MaaS gateway" vertex="1">
          <mxGeometry height="200" width="490" x="20" y="480" as="geometry" />
        </mxCell>
        <mxCell id="s3req" parent="s3box" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;" value="POST https://agents-maas.apps.&lt;domain&gt;/maas-api/v1/api-keys&#xa;&#xa;Headers:&#xa;  Authorization: Bearer &lt;JWT&gt;&#xa;  Content-Type: application/json&#xa;&#xa;Body:&#xa;  {name: agent-chatbot-1-..., expiresIn: 300s}   ← from this group&#39;s keyTtlSeconds" vertex="1">
          <mxGeometry height="110" width="460" x="15" y="30" as="geometry" />
        </mxCell>
        <mxCell id="s3resp" parent="s3box" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="← Response: {key: sk-oai-xxxx, subscription: agents-chatbots-tier}&#xa;(cached for this group&#39;s keyTtlSeconds — 300s for chatbots)" vertex="1">
          <mxGeometry height="35" width="460" x="15" y="155" as="geometry" />
        </mxCell>
        <mxCell id="s4box" parent="wc" style="swimlane;startSize=25;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" value="④ Inference Call — Agent calls model via gateway" vertex="1">
          <mxGeometry height="225" width="490" x="20" y="750" as="geometry" />
        </mxCell>
        <mxCell id="s4req" parent="s4box" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;" value="POST https://agents-maas.apps.&lt;domain&gt;&#xa;      /llm/facebook-opt-125m-simulated/v1/chat/completions&#xa;&#xa;Headers:&#xa;  Authorization: Bearer sk-oai-xxxx&#xa;  Content-Type: application/json&#xa;&#xa;Body:&#xa;  {&#xa;    model: facebook/opt-125m,&#xa;    messages: [{role: user, content: ...}],&#xa;    max_tokens: 50&#xa;  }" vertex="1">
          <mxGeometry height="150" width="460" x="15" y="30" as="geometry" />
        </mxCell>
        <mxCell id="s4resp" parent="s4box" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="← Response: {choices:[...], usage:{total_tokens:37}}" vertex="1">
          <mxGeometry height="25" width="460" x="15" y="190" as="geometry" />
        </mxCell>
        <mxCell id="s5box" parent="wc" style="swimlane;startSize=25;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" value="⑤ Agent Logs Result + Waits + Loops" vertex="1">
          <mxGeometry height="175" width="490" x="20" y="1055" as="geometry" />
        </mxCell>
        <mxCell id="s5log" parent="s5box" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;" value="Agent logs (pod stdout):&#xa;[21:05:59] 💬 [200] 0.40s | conversational | tokens: 37&#xa;&#xa;Counters also update on :8080/status — requests, tokens, 2xx vs 4xx/5xx, uptime" vertex="1">
          <mxGeometry height="70" width="460" x="15" y="30" as="geometry" />
        </mxCell>
        <mxCell id="s5wait" parent="s5box" style="rounded=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" value="Waits thinkTime (random 3-8s) then loops back to ④&#xa;JWT auto-refreshed 30s before expiry (every ~4.5min)&#xa;API key cached for keyTtlSeconds, re-minted at -10% (300s → refresh at -30s)&#xa;⚠ server ceiling is the only enforced bound: maxExpirationDays = 1 day" vertex="1">
          <mxGeometry height="50" width="460" x="15" y="110" as="geometry" />
        </mxCell>
        <mxCell id="ef1" edge="1" parent="wc" source="s1box" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#6c8ebf;strokeWidth=2;" target="s2box" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ef2" edge="1" parent="wc" source="s2box" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#6c8ebf;strokeWidth=2;" target="s3box" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ef3" edge="1" parent="wc" source="s3box" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#6c8ebf;strokeWidth=2;" target="s4box" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ef4" edge="1" parent="wc" source="s4box" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#6c8ebf;strokeWidth=2;" target="s5box" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eloop" edge="1" parent="wc" source="s5box" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;fontSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" target="s4box" value="loop (thinkTime)">
          <mxGeometry relative="1" x="0.0408" y="-40" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="10.03" y="1142.48" />
              <mxPoint x="10.03" y="917.52" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="inet" parent="1" style="text;html=1;fontSize=12;fontStyle=2;align=center;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;" value="Public Internet (HTTPS)" vertex="1">
          <mxGeometry height="35" width="190" x="555" y="770" as="geometry" />
        </mxCell>
        <mxCell id="mc" parent="1" style="swimlane;startSize=35;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;" value="MaaS Cluster" vertex="1">
          <mxGeometry height="2000" width="720" x="760" y="55" as="geometry" />
        </mxCell>
        <mxCell id="s2kc" parent="mc" style="swimlane;startSize=25;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" value="Keycloak — agent-realm" vertex="1">
          <mxGeometry height="315" width="680" x="20" y="95" as="geometry" />
        </mxCell>
        <mxCell id="s2kc1" parent="s2kc" style="text;html=1;fontSize=11;" value="1. Validates client_id=chatbot-1 credentials" vertex="1">
          <mxGeometry height="20" width="650" x="15" y="30" as="geometry" />
        </mxCell>
        <mxCell id="s2kc2" parent="s2kc" style="text;html=1;fontSize=11;" value="2. Looks up service-account-chatbot-1 → member of chatbots group" vertex="1">
          <mxGeometry height="20" width="650" x="15" y="55" as="geometry" />
        </mxCell>
        <mxCell id="s2kc3" parent="s2kc" style="text;html=1;fontSize=11;" value="3. Runs groups claim mapper → adds groups=[chatbots] to token" vertex="1">
          <mxGeometry height="20" width="650" x="15" y="80" as="geometry" />
        </mxCell>
        <mxCell id="s2kc4" parent="s2kc" style="text;html=1;fontSize=11;" value="4. Runs audience mapper → adds maas-agents to aud claim" vertex="1">
          <mxGeometry height="20" width="650" x="15" y="105" as="geometry" />
        </mxCell>
        <mxCell id="s2jwt" parent="s2kc" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;" value="JWT returned: {&#xa;  iss: .../realms/agent-realm,&#xa;  azp: chatbot-1,&#xa;  aud: [maas-agents, account],&#xa;  groups: [chatbots],&#xa;  preferred_username: service-account-chatbot-1,&#xa;  exp: &lt;now + 300s&gt;&#xa;}" vertex="1">
          <mxGeometry height="140" width="650" x="15" y="130" as="geometry" />
        </mxCell>
        <mxCell id="s3gw" parent="mc" style="swimlane;startSize=25;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" value="agents-maas-gateway + AuthPolicy + maas-api-agents" vertex="1">
          <mxGeometry height="215" width="680" x="20" y="415" as="geometry" />
        </mxCell>
        <mxCell id="s3gw1" parent="s3gw" style="text;html=1;fontSize=11;" value="1. agents-maas-gateway receives POST /maas-api/v1/api-keys" vertex="1">
          <mxGeometry height="20" width="650" x="15" y="30" as="geometry" />
        </mxCell>
        <mxCell id="s3gw2" parent="s3gw" style="text;html=1;fontSize=11;" value="2. Kuadrant AuthPolicy — oidc-identities rule: validates JWT" vertex="1">
          <mxGeometry height="20" width="650" x="15" y="55" as="geometry" />
        </mxCell>
        <mxCell id="s3gw3" parent="s3gw" style="text;html=1;fontSize=10;" value="   • Fetches JWKS from agent-realm (cached 300s) → validates signature" vertex="1">
          <mxGeometry height="18" width="650" x="15" y="75" as="geometry" />
        </mxCell>
        <mxCell id="s3gw4" parent="s3gw" style="text;html=1;fontSize=10;" value="   • Checks issuer matches ✓  |  ⚠ aud is NOT checked — no &#39;audiences&#39; set on oidc-identities" vertex="1">
          <mxGeometry height="18" width="650" x="15" y="93" as="geometry" />
        </mxCell>
        <mxCell id="s3gw5" parent="s3gw" style="text;html=1;fontSize=11;" value="3. Routes to maas-api-agents (/maas-api/* → maas-api-route-agents HTTPRoute)" vertex="1">
          <mxGeometry height="20" width="650" x="15" y="115" as="geometry" />
        </mxCell>
        <mxCell id="s3gw6" parent="s3gw" style="text;html=1;fontSize=11;" value="4. maas-api-agents resolves identity: preferred_username=service-account-chatbot-1" vertex="1">
          <mxGeometry height="20" width="650" x="15" y="140" as="geometry" />
        </mxCell>
        <mxCell id="s3gw7" parent="s3gw" style="text;html=1;fontSize=10;" value="   → groups=[chatbots] → matches agents-chatbots-tier subscription (priority 35)" vertex="1">
          <mxGeometry height="18" width="650" x="15" y="160" as="geometry" />
        </mxCell>
        <mxCell id="s3gw8" parent="s3gw" style="text;html=1;fontSize=11;" value="5. Mints API key sk-oai-xxxx | stores in DB bound to subscription agents-chatbots-tier" vertex="1">
          <mxGeometry height="20" width="650" x="15" y="185" as="geometry" />
        </mxCell>
        <mxCell id="s4gw" parent="mc" style="swimlane;startSize=25;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" value="agents-maas-gateway — Inference Routing" vertex="1">
          <mxGeometry height="460" width="680" x="20" y="640" as="geometry" />
        </mxCell>
        <mxCell id="s4gw1" parent="s4gw" style="text;html=1;fontSize=11;" value="1. Gateway receives POST /llm/facebook-opt-125m-simulated/v1/chat/completions" vertex="1">
          <mxGeometry height="20" width="650" x="15" y="30" as="geometry" />
        </mxCell>
        <mxCell id="s4gw2" parent="s4gw" style="text;html=1;fontSize=11;" value="2. Kuadrant AuthPolicy — api-keys rule: token matches ^Bearer sk-oai-.*" vertex="1">
          <mxGeometry height="20" width="650" x="15" y="55" as="geometry" />
        </mxCell>
        <mxCell id="s4gw3" parent="s4gw" style="text;html=1;fontSize=11;" value="3. WASM rate-limiter calls maas-api-agents: validates API key + checks rate limit" vertex="1">
          <mxGeometry height="20" width="650" x="15" y="80" as="geometry" />
        </mxCell>
        <mxCell id="s4gw3b" parent="s4gw" style="text;html=1;fontSize=10;" value="   → Resolves sk-oai-xxxx → subscription agents-chatbots-tier → 500 t/min budget" vertex="1">
          <mxGeometry height="18" width="650" x="15" y="100" as="geometry" />
        </mxCell>
        <mxCell id="s4gw3c" parent="s4gw" style="text;html=1;fontSize=10;" value="   → If chatbot-2: matches agents-chatbot-2-premium (priority 50 wins) → 2000 t/min budget" vertex="1">
          <mxGeometry height="18" width="650" x="15" y="118" as="geometry" />
        </mxCell>
        <mxCell id="s4gw4" parent="s4gw" style="text;html=1;fontSize=11;" value="4. require-group-membership OPA check:" vertex="1">
          <mxGeometry height="20" width="650" x="15" y="142" as="geometry" />
        </mxCell>
        <mxCell id="s4gw4b" parent="s4gw" style="text;html=1;fontSize=10;" value="   model_identity = llm/facebook-opt-125m-simulated (from path)&#xa;   groups = [chatbots] → model_access[model_identity].groups includes chatbots ✓" vertex="1">
          <mxGeometry height="30" width="650" x="15" y="164" as="geometry" />
        </mxCell>
        <mxCell id="s4gw5" parent="s4gw" style="text;html=1;fontSize=11;" value="5. HTTPRoute facebook-opt-125m-simulated-kserve-route matches path prefix" vertex="1">
          <mxGeometry height="20" width="650" x="15" y="198" as="geometry" />
        </mxCell>
        <mxCell id="s4gw6" parent="s4gw" style="text;html=1;fontSize=11;" value="6. URL rewrite: /llm/facebook-opt-125m-simulated/v1/chat/completions → /v1/chat/completions" vertex="1">
          <mxGeometry height="20" width="650" x="15" y="223" as="geometry" />
        </mxCell>
        <mxCell id="s4gw7" parent="s4gw" style="text;html=1;fontSize=11;" value="7. Forwards to facebook-opt-125m-simulated-kserve-workload-svc:8000 (HTTPS)" vertex="1">
          <mxGeometry height="20" width="650" x="15" y="248" as="geometry" />
        </mxCell>
        <mxCell id="s4ks" parent="s4gw" style="swimlane;startSize=22;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" value="facebook-opt-125m-simulated-kserve-workload-svc (namespace: llm)" vertex="1">
          <mxGeometry height="120" width="650" x="15" y="278" as="geometry" />
        </mxCell>
        <mxCell id="s4ks1" parent="s4ks" style="text;html=1;fontSize=11;" value="8. kserve simulator receives POST /v1/chat/completions" vertex="1">
          <mxGeometry height="18" width="630" x="10" y="25" as="geometry" />
        </mxCell>
        <mxCell id="s4ks2" parent="s4ks" style="text;html=1;fontSize=10;" value="   Body: {model: facebook/opt-125m, messages: [...], max_tokens: 50}" vertex="1">
          <mxGeometry height="18" width="630" x="10" y="43" as="geometry" />
        </mxCell>
        <mxCell id="s4ks3" parent="s4ks" style="text;html=1;fontSize=10;" value="   Note: model name MUST be HuggingFace ID (facebook/opt-125m),&#xa;   NOT the K8s resource name (facebook-opt-125m-simulated)" vertex="1">
          <mxGeometry height="30" width="630" x="10" y="63" as="geometry" />
        </mxCell>
        <mxCell id="s4ks4" parent="s4ks" style="text;html=1;fontSize=10;" value="9. Returns: {id:.., model: facebook/opt-125m, choices:[{message:{content:...}}], usage:{total_tokens:37}}" vertex="1">
          <mxGeometry height="18" width="630" x="10" y="95" as="geometry" />
        </mxCell>
        <mxCell id="rl_note" parent="mc" style="swimlane;startSize=22;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" value="Rate Limiting (Kuadrant Limitador + WASM plugin)" vertex="1">
          <mxGeometry height="160" width="680" x="20" y="1120" as="geometry" />
        </mxCell>
        <mxCell id="rl1" parent="rl_note" style="text;html=1;fontSize=11;fontStyle=1;" value="Subscription tiers enforced per-gateway (independent counters):" vertex="1">
          <mxGeometry height="20" width="650" x="15" y="28" as="geometry" />
        </mxCell>
        <mxCell id="rl2" parent="rl_note" style="text;html=1;fontSize=11;" value="• chatbot-1: agents-chatbots-tier → 500 tokens/minute (priority 35)" vertex="1">
          <mxGeometry height="20" width="650" x="15" y="50" as="geometry" />
        </mxCell>
        <mxCell id="rl3" parent="rl_note" style="text;html=1;fontSize=11;" value="• chatbot-2: agents-chatbot-2-premium → 2000 tokens/minute (priority 50 overrides group)" vertex="1">
          <mxGeometry height="20" width="650" x="15" y="72" as="geometry" />
        </mxCell>
        <mxCell id="rl4" parent="rl_note" style="text;html=1;fontSize=11;" value="• reviewer-1, reviewer-2: agents-reviewers-tier → 200 tokens/minute (priority 35)" vertex="1">
          <mxGeometry height="20" width="650" x="15" y="94" as="geometry" />
        </mxCell>
        <mxCell id="rl5" parent="rl_note" style="text;html=1;fontSize=11;" value="• analyst-1: agents-analysts-tier → 300 tokens/minute (priority 35)" vertex="1">
          <mxGeometry height="20" width="650" x="15" y="116" as="geometry" />
        </mxCell>
        <mxCell id="rev_note" parent="mc" style="swimlane;startSize=22;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" value="Revocation" vertex="1">
          <mxGeometry height="110" width="680" x="20" y="1300" as="geometry" />
        </mxCell>
        <mxCell id="rev1" parent="rev_note" style="text;html=1;fontSize=11;" value="Per-agent: delete/disable Keycloak client → stops NEW keys, but the cached API key keeps working&#xa;⚠ lockout is bounded by that group&#39;s keyTtlSeconds (120–600s here), NOT the 5min JWT TTL&#xa;— inference validates sk-oai-* at maas-api, never at Keycloak" vertex="1">
          <mxGeometry height="20" width="650" x="15" y="28" as="geometry" />
        </mxCell>
        <mxCell id="rev2" parent="rev_note" style="text;html=1;fontSize=11;" value="Per-group: delete MaaSSubscription → 403 on next call (subscription-valid runs per request)&#xa;⚠ deleting MaaSAuthPolicy does nothing here — managed=false leaves those CRs Pending/inert; model_access is injected by hand" vertex="1">
          <mxGeometry height="20" width="650" x="15" y="52" as="geometry" />
        </mxCell>
        <mxCell id="rev3" parent="rev_note" style="text;html=1;fontSize=11;" value="Entire tenant: delete AITenant → all agents lose access" vertex="1">
          <mxGeometry height="20" width="650" x="15" y="76" as="geometry" />
        </mxCell>
        <mxCell id="e_s2" edge="1" parent="1" source="s2box" style="edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=10;fontStyle=1;strokeColor=#b85450;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="s2kc" value="② POST token endpoint">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_s3" edge="1" parent="1" source="s3box" style="edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=10;fontStyle=1;strokeColor=#d79b00;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="s3gw" value="③ POST /maas-api/v1/api-keys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_s4" edge="1" parent="1" source="s4box" style="edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=10;fontStyle=1;strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="s4gw" value="④ POST /llm/.../v1/chat/completions">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

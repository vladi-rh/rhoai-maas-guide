<mxfile>
  <diagram id="runtime" name="Runtime Flow">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="2100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="t0" value="Cross-Cluster Agents Demo — Runtime Flow" style="text;html=1;fontSize=20;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="350" y="10" width="800" height="35" as="geometry"/>
        </mxCell>

        <!-- Workload Cluster column -->
        <mxCell id="wc" value="Workload Cluster" style="swimlane;startSize=35;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="10" y="55" width="530" height="2000" as="geometry"/>
        </mxCell>

        <!-- Internet divider label -->
        <mxCell id="inet" value="Public Internet (HTTPS)" style="text;html=1;fontSize=12;fontStyle=2;align=center;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="555" y="800" width="190" height="35" as="geometry"/>
        </mxCell>

        <!-- MaaS Cluster column -->
        <mxCell id="mc" value="MaaS Cluster" style="swimlane;startSize=35;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="760" y="55" width="720" height="2000" as="geometry"/>
        </mxCell>

        <!-- Legend box -->
        <mxCell id="legend" value="Agent: chatbot-1 (agents-chatbots ns)&#xa;Pattern: conversational | Group: chatbots" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontStyle=2;" vertex="1" parent="wc">
          <mxGeometry x="20" y="50" width="490" height="45" as="geometry"/>
        </mxCell>

        <!-- STEP 1: Read start signal -->
        <mxCell id="s1box" value="① Read Start Signal" style="swimlane;startSize=25;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="wc">
          <mxGeometry x="20" y="110" width="490" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="s1cm" value="ConfigMap: start-signal&#xa;signal: go" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="s1box">
          <mxGeometry x="15" y="30" width="180" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="s1prof" value="ConfigMap: agent-profile&#xa;pattern: conversational&#xa;thinkTimeMin: 3s, Max: 8s" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="s1box">
          <mxGeometry x="215" y="30" width="255" height="50" as="geometry"/>
        </mxCell>

        <!-- STEP 2: Token Mint - workload side -->
        <mxCell id="s2box" value="② Token Mint — Agent calls Keycloak" style="swimlane;startSize=25;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="wc">
          <mxGeometry x="20" y="230" width="490" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="s2req" value="POST https://sso.apps.&lt;domain&gt;/realms/agent-realm&#xa;      /protocol/openid-connect/token&#xa;&#xa;Body:&#xa;  grant_type=client_credentials&#xa;  client_id=chatbot-1&#xa;  client_secret=&lt;from K8s Secret&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;" vertex="1" parent="s2box">
          <mxGeometry x="15" y="30" width="460" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="s2resp" value="← Response: JWT (cached until exp-30s)" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="s2box">
          <mxGeometry x="15" y="135" width="460" height="35" as="geometry"/>
        </mxCell>

        <!-- STEP 2: Token Mint - Keycloak side -->
        <mxCell id="s2kc" value="Keycloak — agent-realm" style="swimlane;startSize=25;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="mc">
          <mxGeometry x="20" y="175" width="680" height="235" as="geometry"/>
        </mxCell>
        <mxCell id="s2kc1" value="1. Validates client_id=chatbot-1 credentials" style="text;html=1;fontSize=11;" vertex="1" parent="s2kc">
          <mxGeometry x="15" y="30" width="650" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="s2kc2" value="2. Looks up service-account-chatbot-1 → member of chatbots group" style="text;html=1;fontSize=11;" vertex="1" parent="s2kc">
          <mxGeometry x="15" y="55" width="650" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="s2kc3" value="3. Runs groups claim mapper → adds groups=[chatbots] to token" style="text;html=1;fontSize=11;" vertex="1" parent="s2kc">
          <mxGeometry x="15" y="80" width="650" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="s2kc4" value="4. Runs audience mapper → adds maas-agents to aud claim" style="text;html=1;fontSize=11;" vertex="1" parent="s2kc">
          <mxGeometry x="15" y="105" width="650" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="s2jwt" value="JWT returned: {&#xa;  iss: .../realms/agent-realm,&#xa;  azp: chatbot-1,&#xa;  aud: [maas-agents, account],&#xa;  groups: [chatbots],&#xa;  preferred_username: service-account-chatbot-1,&#xa;  exp: &lt;now + 300s&gt;&#xa;}" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;" vertex="1" parent="s2kc">
          <mxGeometry x="15" y="130" width="650" height="90" as="geometry"/>
        </mxCell>

        <!-- STEP 3: API Key Mint - workload side -->
        <mxCell id="s3box" value="③ API Key Mint — Agent calls MaaS gateway" style="swimlane;startSize=25;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="wc">
          <mxGeometry x="20" y="430" width="490" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="s3req" value="POST https://agents-maas.apps.&lt;domain&gt;/maas-api/v1/api-keys&#xa;&#xa;Headers:&#xa;  Authorization: Bearer &lt;JWT&gt;&#xa;  Content-Type: application/json&#xa;&#xa;Body:&#xa;  {name: agent-chatbot-1-..., expiresIn: 3600s}" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;" vertex="1" parent="s3box">
          <mxGeometry x="15" y="30" width="460" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="s3resp" value="← Response: {key: sk-oai-xxxx, subscription: agents-chatbots-tier}&#xa;(API key cached for 1 hour)" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="s3box">
          <mxGeometry x="15" y="155" width="460" height="35" as="geometry"/>
        </mxCell>

        <!-- STEP 3: API Key Mint - Gateway + maas-api-agents side -->
        <mxCell id="s3gw" value="agents-maas-gateway + AuthPolicy + maas-api-agents" style="swimlane;startSize=25;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="mc">
          <mxGeometry x="20" y="415" width="680" height="215" as="geometry"/>
        </mxCell>
        <mxCell id="s3gw1" value="1. agents-maas-gateway receives POST /maas-api/v1/api-keys" style="text;html=1;fontSize=11;" vertex="1" parent="s3gw">
          <mxGeometry x="15" y="30" width="650" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="s3gw2" value="2. Kuadrant AuthPolicy — oidc-identities rule: validates JWT" style="text;html=1;fontSize=11;" vertex="1" parent="s3gw">
          <mxGeometry x="15" y="55" width="650" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="s3gw3" value="   • Fetches JWKS from agent-realm (cached 300s) → validates signature" style="text;html=1;fontSize=10;" vertex="1" parent="s3gw">
          <mxGeometry x="15" y="75" width="650" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="s3gw4" value="   • Checks aud contains maas-agents ✓ | Checks issuer matches ✓" style="text;html=1;fontSize=10;" vertex="1" parent="s3gw">
          <mxGeometry x="15" y="93" width="650" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="s3gw5" value="3. Routes to maas-api-agents (/maas-api/* → maas-api-route-agents HTTPRoute)" style="text;html=1;fontSize=11;" vertex="1" parent="s3gw">
          <mxGeometry x="15" y="115" width="650" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="s3gw6" value="4. maas-api-agents resolves identity: preferred_username=service-account-chatbot-1" style="text;html=1;fontSize=11;" vertex="1" parent="s3gw">
          <mxGeometry x="15" y="140" width="650" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="s3gw7" value="   → groups=[chatbots] → matches agents-chatbots-tier subscription (priority 35)" style="text;html=1;fontSize=10;" vertex="1" parent="s3gw">
          <mxGeometry x="15" y="160" width="650" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="s3gw8" value="5. Mints API key sk-oai-xxxx | stores in DB bound to subscription agents-chatbots-tier" style="text;html=1;fontSize=11;" vertex="1" parent="s3gw">
          <mxGeometry x="15" y="185" width="650" height="20" as="geometry"/>
        </mxCell>

        <!-- STEP 4: Inference - workload side -->
        <mxCell id="s4box" value="④ Inference Call — Agent calls model via gateway" style="swimlane;startSize=25;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="wc">
          <mxGeometry x="20" y="650" width="490" height="225" as="geometry"/>
        </mxCell>
        <mxCell id="s4req" value="POST https://agents-maas.apps.&lt;domain&gt;&#xa;      /llm/facebook-opt-125m-simulated/v1/chat/completions&#xa;&#xa;Headers:&#xa;  Authorization: Bearer sk-oai-xxxx&#xa;  Content-Type: application/json&#xa;&#xa;Body:&#xa;  {&#xa;    model: facebook/opt-125m,&#xa;    messages: [{role: user, content: ...}],&#xa;    max_tokens: 50&#xa;  }" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;" vertex="1" parent="s4box">
          <mxGeometry x="15" y="30" width="460" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="s4resp" value="← Response: {choices:[...], usage:{total_tokens:37}}" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="s4box">
          <mxGeometry x="15" y="190" width="460" height="25" as="geometry"/>
        </mxCell>

        <!-- STEP 4: Inference - Gateway + WASM + kserve side -->
        <mxCell id="s4gw" value="agents-maas-gateway — Inference Routing" style="swimlane;startSize=25;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="mc">
          <mxGeometry x="20" y="640" width="680" height="460" as="geometry"/>
        </mxCell>
        <mxCell id="s4gw1" value="1. Gateway receives POST /llm/facebook-opt-125m-simulated/v1/chat/completions" style="text;html=1;fontSize=11;" vertex="1" parent="s4gw">
          <mxGeometry x="15" y="30" width="650" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="s4gw2" value="2. Kuadrant AuthPolicy — api-keys rule: token matches ^Bearer sk-oai-.*" style="text;html=1;fontSize=11;" vertex="1" parent="s4gw">
          <mxGeometry x="15" y="55" width="650" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="s4gw3" value="3. WASM rate-limiter calls maas-api-agents: validates API key + checks rate limit" style="text;html=1;fontSize=11;" vertex="1" parent="s4gw">
          <mxGeometry x="15" y="80" width="650" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="s4gw3b" value="   → Resolves sk-oai-xxxx → subscription agents-chatbots-tier → 500 t/min budget" style="text;html=1;fontSize=10;" vertex="1" parent="s4gw">
          <mxGeometry x="15" y="100" width="650" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="s4gw3c" value="   → If chatbot-2: matches chatbot-2-premium (priority 50 wins) → 2000 t/min budget" style="text;html=1;fontSize=10;" vertex="1" parent="s4gw">
          <mxGeometry x="15" y="118" width="650" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="s4gw4" value="4. require-group-membership OPA check:" style="text;html=1;fontSize=11;" vertex="1" parent="s4gw">
          <mxGeometry x="15" y="142" width="650" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="s4gw4b" value="   model_identity = llm/facebook-opt-125m-simulated (from path)&#xa;   groups = [chatbots] → model_access[model_identity].groups includes chatbots ✓" style="text;html=1;fontSize=10;" vertex="1" parent="s4gw">
          <mxGeometry x="15" y="160" width="650" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="s4gw5" value="5. HTTPRoute facebook-opt-125m-simulated-kserve-route matches path prefix" style="text;html=1;fontSize=11;" vertex="1" parent="s4gw">
          <mxGeometry x="15" y="198" width="650" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="s4gw6" value="6. URL rewrite: /llm/facebook-opt-125m-simulated/v1/chat/completions → /v1/chat/completions" style="text;html=1;fontSize=11;" vertex="1" parent="s4gw">
          <mxGeometry x="15" y="223" width="650" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="s4gw7" value="7. Forwards to facebook-opt-125m-simulated-kserve-workload-svc:8000 (HTTPS)" style="text;html=1;fontSize=11;" vertex="1" parent="s4gw">
          <mxGeometry x="15" y="248" width="650" height="20" as="geometry"/>
        </mxCell>

        <!-- kserve box inside gateway step -->
        <mxCell id="s4ks" value="facebook-opt-125m-simulated-kserve-workload-svc (namespace: llm)" style="swimlane;startSize=22;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="s4gw">
          <mxGeometry x="15" y="278" width="650" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="s4ks1" value="8. kserve simulator receives POST /v1/chat/completions" style="text;html=1;fontSize=11;" vertex="1" parent="s4ks">
          <mxGeometry x="10" y="25" width="630" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="s4ks2" value="   Body: {model: facebook/opt-125m, messages: [...], max_tokens: 50}" style="text;html=1;fontSize=10;" vertex="1" parent="s4ks">
          <mxGeometry x="10" y="43" width="630" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="s4ks3" value="   Note: model name MUST be HuggingFace ID (facebook/opt-125m),&#xa;   NOT the K8s resource name (facebook-opt-125m-simulated)" style="text;html=1;fontSize=10;" vertex="1" parent="s4ks">
          <mxGeometry x="10" y="63" width="630" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="s4ks4" value="9. Returns: {id:.., model: facebook/opt-125m, choices:[{message:{content:...}}], usage:{total_tokens:37}}" style="text;html=1;fontSize=10;" vertex="1" parent="s4ks">
          <mxGeometry x="10" y="95" width="630" height="18" as="geometry"/>
        </mxCell>

        <!-- STEP 5: Logging + Loop -->
        <mxCell id="s5box" value="⑤ Agent Logs Result + Waits + Loops" style="swimlane;startSize=25;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="wc">
          <mxGeometry x="20" y="895" width="490" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="s5log" value="Agent logs:&#xa;[21:05:59] [AGENT] [chatbot-1] POST .../v1/chat/completions → 200 (0.40s, 37 tokens)&#xa;[21:05:59] [AGENT] [chatbot-1] [200] 0.40s | conversational | tokens: 37" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;" vertex="1" parent="s5box">
          <mxGeometry x="15" y="30" width="460" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="s5wait" value="Waits thinkTime (random 3-8s) then loops back to ④&#xa;Token auto-refreshed 30s before expiry (every ~4.5min)&#xa;API key cached 1 hour — reused across inference calls" style="rounded=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="s5box">
          <mxGeometry x="15" y="110" width="460" height="50" as="geometry"/>
        </mxCell>

        <!-- Rate limit note in MaaS column -->
        <mxCell id="rl_note" value="Rate Limiting (Kuadrant Limitador + WASM plugin)" style="swimlane;startSize=22;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="mc">
          <mxGeometry x="20" y="1120" width="680" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="rl1" value="Subscription tiers enforced per-gateway (independent counters):" style="text;html=1;fontSize=11;fontStyle=1;" vertex="1" parent="rl_note">
          <mxGeometry x="15" y="28" width="650" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="rl2" value="• chatbot-1: agents-chatbots-tier → 500 tokens/minute (priority 35)" style="text;html=1;fontSize=11;" vertex="1" parent="rl_note">
          <mxGeometry x="15" y="50" width="650" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="rl3" value="• chatbot-2: chatbot-2-premium → 2000 tokens/minute (priority 50 overrides group)" style="text;html=1;fontSize=11;" vertex="1" parent="rl_note">
          <mxGeometry x="15" y="72" width="650" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="rl4" value="• reviewer-1, reviewer-2: agents-reviewers-tier → 200 tokens/minute (priority 35)" style="text;html=1;fontSize=11;" vertex="1" parent="rl_note">
          <mxGeometry x="15" y="94" width="650" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="rl5" value="• analyst-1: agents-analysts-tier → 300 tokens/minute (priority 35)" style="text;html=1;fontSize=11;" vertex="1" parent="rl_note">
          <mxGeometry x="15" y="116" width="650" height="20" as="geometry"/>
        </mxCell>

        <!-- Revocation note -->
        <mxCell id="rev_note" value="Revocation" style="swimlane;startSize=22;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="mc">
          <mxGeometry x="20" y="1300" width="680" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="rev1" value="Per-agent: delete/disable Keycloak client → no new tokens → locked out within JWT TTL (5min)" style="text;html=1;fontSize=11;" vertex="1" parent="rev_note">
          <mxGeometry x="15" y="28" width="650" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="rev2" value="Per-group: delete MaaSAuthPolicy or MaaSSubscription for that group → 403 on next call" style="text;html=1;fontSize=11;" vertex="1" parent="rev_note">
          <mxGeometry x="15" y="52" width="650" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="rev3" value="Entire tenant: delete AITenant → all agents lose access" style="text;html=1;fontSize=11;" vertex="1" parent="rev_note">
          <mxGeometry x="15" y="76" width="650" height="20" as="geometry"/>
        </mxCell>

        <!-- EDGES (cross-cluster) -->

        <!-- Step 2: Agent → Keycloak (token mint request) -->
        <mxCell id="e_s2" value="② POST token endpoint" style="edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=10;fontStyle=1;strokeColor=#b85450;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="s2box" target="s2kc" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Step 3: Agent → Gateway (API key mint) -->
        <mxCell id="e_s3" value="③ POST /maas-api/v1/api-keys" style="edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=10;fontStyle=1;strokeColor=#d79b00;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="s3box" target="s3gw" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Step 4: Agent → Gateway (inference) -->
        <mxCell id="e_s4" value="④ POST /llm/.../v1/chat/completions" style="edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=10;fontStyle=1;strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="s4box" target="s4gw" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Flow arrows within workload column -->
        <mxCell id="ef1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" source="s1box" target="s2box" parent="wc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ef2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" source="s2box" target="s3box" parent="wc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ef3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" source="s3box" target="s4box" parent="wc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ef4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" source="s4box" target="s5box" parent="wc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Loop back arrow -->
        <mxCell id="eloop" value="loop (thinkTime)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;fontSize=10;" edge="1" source="s5box" target="s4box" parent="wc">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="20" y="982"/>
              <mxPoint x="20" y="762"/>
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
